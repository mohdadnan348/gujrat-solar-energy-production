
# ===================================
# DEPENDENCIES
# ===================================
node_modules/
**/node_modules/

# ===================================
# ENVIRONMENT VARIABLES
# ===================================
.env
.env.*
!.env.example
!.env.production.example

# ===================================
# BUILD FILES
# ===================================
dist/
build/
**/dist/
**/build/

# ===================================
# CACHE
# ===================================
.cache/
**/.cache/
.npm/
.eslintcache/
.parcel-cache/
.vite/
.turbo/

# Puppeteer / Chrome
backend/.cache/puppeteer/
**/.cache/puppeteer/

# ===================================
# LOGS
# ===================================
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# ===================================
# UPLOADS
# ===================================
backend/uploads/*
!backend/uploads/.gitkeep

# ===================================
